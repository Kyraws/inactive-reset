<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WebView2 also references WPF; this host only uses its WinForms control. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <ProjectReference Include="../../src/InactiveReset.Ui/InactiveReset.Ui.csproj" />
    <Compile Include="../Support/UiTestHost.cs" Link="Support/UiTestHost.cs" />
  </ItemGroup>
</Project>
