<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings live in Directory.Build.props at the repository root. -->
  <PropertyGroup>
    <RootNamespace>InactiveReset.Core</RootNamespace>
    <!--
      Required by [LibraryImport], whose source-generated marshalling stubs are
      unsafe. Confined to this project: the CLI and UI never need it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InactiveReset.Tests" />
    <InternalsVisibleTo Include="inactive-reset-reanchor" />
    <EmbeddedResource Include="discovery-*.json" LogicalName="InactiveReset.Core.%(Filename)%(Extension)" />
    <EmbeddedResource Include="vehicle-catalog.tsv" LogicalName="InactiveReset.Core.vehicle-catalog.tsv" />
  </ItemGroup>
</Project>
