<Project>

  <!--
    Shared settings for every project. MSBuild imports this file automatically
    before each .csproj, so these do not need repeating per project.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- x64 only: every offset in this repository is for the 64-bit game. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!--
      The tool's own version. It deliberately does NOT track the Le Mans Ultimate
      build: the binary discovers offsets locally for the running build. Naming a
      release after one LMU build would claim a compatibility limit that does not
      exist, and force a re-release every patch to ship identical binaries.
      Which LMU builds a release was verified against belongs in the release
      notes, and `status` prints the running build anyway.
    -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!--
    All build output goes to artifacts/ instead of a bin/ and obj/ beside every
    project. One directory to ignore, one to delete.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
